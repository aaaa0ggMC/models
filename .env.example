# AgentGateway 环境变量样例。
#
# 复制为 .env 后按需修改；.env 不入库（.gitignore 已排除），本文件入库存档。
# **仓库里绝不出现真实 key**——上游 provider 的 key 一律走环境变量（AGENTS.md）。
#
# 变量名只登记在这里与 di/config.ts；其他模块不得直接读 process.env。

# ---- 上游 provider key（仅变量名进配置对象，值由 credentials/resolver.ts 按需读取）----
# 不设置也能起服务：默认路由表走 mock 上游（ScriptedTransport），不起真实 API。
AG_OPENAI_API_KEY=
AG_ANTHROPIC_API_KEY=
AG_GEMINI_API_KEY=

# ---- HTTP ingress ----
AG_PORT=8787
AG_HOST=127.0.0.1

# ---- 超时预算（20-pipeline.md §S0 / §S5）----
# 全局上限 ms
AG_GLOBAL_TIMEOUT_MS=300000
# 上游首字节超时（TTFB）ms
AG_TTFB_TIMEOUT_MS=30000
# 流式空闲超时：杀"发了首块后静默"的流
AG_STREAM_IDLE_TIMEOUT_MS=120000

# ---- 重试 / fallback（20-pipeline.md §7.3）----
# 同 attempt 内最大重试次数
AG_MAX_RETRIES=2
# 指数退避基数 ms
AG_RETRY_BASE_DELAY_MS=200

# ---- 网关工具循环（20-pipeline.md §5.2）----
AG_MAX_TURNS=10

# ---- 插件（30-plugin-api.md）----
# 插件单次调用超时 ms
AG_PLUGIN_TIMEOUT_MS=5000

# ---- fast path 旁路用量嗅探器（20-pipeline.md §4.2）----
# 字节上限；超限标 usage_sniffer_truncated 而**不**把未知 token 记成 0
AG_USAGE_SNIFFER_MAX_BYTES=262144

# ---- 转换损耗策略（20-pipeline.md §S4）----
# allow = 转换完成 + 记 warning 级诊断（默认）
# safe   = 丢弃 warning 级，遇 error 级诊断立即失败
# strict = 任何诊断都失败
AG_LOSS_POLICY=allow

# ---- 调试 ----
# 响应里带 ag_* 调试字段；上游错误体是否回给客户端（默认不回，20 §7.2）
AG_DEBUG=false
