# AgentGateway 环境变量样例。
#
# 复制为 .env 后按需修改；.env 不入库（.gitignore 已排除），本文件入库存档。
# **仓库里绝不出现真实 key**——上游 provider 的 key 一律走环境变量（AGENTS.md）。
#
# 变量名只登记在这里与 di/config.ts；其他模块不得直接读 process.env。

# ---- 上游 provider key（仅变量名进配置对象，值由 credentials/resolver.ts 按需读取）----
# 不设置也能起服务：默认路由表走 mock 上游（ScriptedTransport），不起真实 API。
#
# **同一渠道可以配多把 key**：编号从 _2 起（主变量不带后缀），例如
#   DEEPSEEK_API_KEY / DEEPSEEK_API_KEY_2 / DEEPSEEK_API_KEY_3
# 上游返回 401 / 403 / 429 时自动换下一把（docs/design/20-pipeline.md §S5）；
# 用量看板按 key 拆（UsageRecord.credential_id）。上限 8 把，再多请走 OS keyring。
AG_OPENAI_API_KEY=
AG_ANTHROPIC_API_KEY=
AG_GEMINI_API_KEY=
# DeepSeek：两个 dialect（deepseek.openai-chat / deepseek.anthropic-messages）共用同一个 key。
# 官方文档：https://api-docs.deepseek.com/ （模型 deepseek-flash / deepseek-v4-pro；
# 旧的 deepseek-chat / deepseek-reasoner 已于 2026-07-24 退役）
DEEPSEEK_API_KEY=
# 可选：DeepSeek 上游 base URL 覆盖（默认 https://api.deepseek.com）。
# 代理 / 内网镜像场景才需要；两 dialect 的路径差异（/chat/completions 与
# /anthropic/v1/messages）由 provider profile 表达，不在这里拼。
DEEPSEEK_BASE_URL=

# 小米 MiMo：一条 access path（mimo.openai-chat，OpenAI 兼容，base 含 /v1）。
# 官方文档：https://mimo.mi.com/docs/zh-CN/api/chat/openai-api-post
# 模型：mimo-v2.6-flash / mimo-v2.6-pro（LLM）、mimo-v2.5-asr（语音识别）、
# mimo-v2.5-tts / -voiceclone / -voicedesign（语音合成）。
# **音频没有独立 REST 端点**（/v1/audio/* 在上游全 404）：TTS/ASR 与 chat 同一个
# /v1/chat/completions，按 model 分发，所以这一把 key 同时覆盖三类能力。
# Token Plan 的 key 形如 tp- 开头；Bearer 或 api-key 头都认（仓库发 Bearer）。
MIMO_API_KEY=

# ---- HTTP ingress ----
AG_PORT=8787
AG_HOST=127.0.0.1

# ---- 超时预算（20-pipeline.md §S0 / §S5）----
# 全局上限 ms
AG_GLOBAL_TIMEOUT_MS=300000
# 上游首字节超时（TTFB）ms
AG_TTFB_TIMEOUT_MS=30000
# 流式空闲超时：杀"发了首块后静默"的流
AG_STREAM_IDLE_TIMEOUT_MS=120000

# ---- 重试 / fallback（20-pipeline.md §7.3）----
# 同 attempt 内最大重试次数
AG_MAX_RETRIES=2
# 指数退避基数 ms
AG_RETRY_BASE_DELAY_MS=200

# ---- 网关工具循环（20-pipeline.md §5.2）----
AG_MAX_TURNS=10

# ---- 插件（30-plugin-api.md）----
# 插件单次调用超时 ms
AG_PLUGIN_TIMEOUT_MS=5000

# ---- 内置助手（docs/design/95-agent-chat.md §6.2）----
# 跑 Agent 用哪条渠道 + 哪个模型（两者必须解析到同一条渠道）
AG_AGENT_ACCESS_PATH=deepseek.openai-chat
AG_AGENT_MODEL=deepseek-flash
# 系统提示词（可查看 / 可编辑 / 可恢复默认）
# AG_AGENT_SYSTEM_PROMPT=
# 工具开关：一行一个工具名（缺省全部开启）
# AG_AGENT_TOOLS=list_channels,list_credentials,list_models,add_provider,create_virtual_key,usage_summary,resolve_alias,test_provider
# 脱敏：数据规则（JSON 数组）、判定函数源码、占位符文本、工具结果是否也脱敏
# AG_AGENT_REDACTION_RULES=[]
# AG_AGENT_REDACTION_DETECT_JS=
AG_AGENT_REDACTION_PLACEHOLDER=<redacted_key>
AG_AGENT_REDACT_TOOL_RESULTS=true
# 会话参数：温度 / 最大输出 / 工具循环上限 / 是否流式
AG_AGENT_TEMPERATURE=0.2
AG_AGENT_MAX_TOKENS=2048
AG_AGENT_MAX_TURNS=8
AG_AGENT_STREAM=true
# 会话持久化：是否把对话记录写进加密存储（默认关）
AG_AGENT_PERSIST_MESSAGES=false

# ---- fast path 旁路用量嗅探器（20-pipeline.md §4.2）----
# 字节上限；超限标 usage_sniffer_truncated 而**不**把未知 token 记成 0
AG_USAGE_SNIFFER_MAX_BYTES=262144

# ---- 转换损耗策略（20-pipeline.md §S4）----
# allow = 转换完成 + 记 warning 级诊断（默认）
# safe   = 丢弃 warning 级，遇 error 级诊断立即失败
# strict = 任何诊断都失败
AG_LOSS_POLICY=allow

# ---- 调试 ----
# 响应里带 ag_* 调试字段；上游错误体是否回给客户端（默认不回，20 §7.2）
AG_DEBUG=false

# ---- 模型目录 /v1/models（元数据分层同步）----
# 启动时是否同步一次上游元数据（默认 true）。关掉 = 只用静态表 + 离线目录，
# 上游拉了也不刷新（适合完全离线的部署）。
AG_MODEL_SYNC_ON_START=true
# 周期同步间隔 ms（默认 15 分钟）。<= 0 = 不定时，只保留启动时 + 管理员触发。
AG_MODEL_SYNC_INTERVAL_MS=900000
# 上游元数据 TTL ms（默认 1 小时）：超过就在响应里标 provenance.stale=true +
# last_successful_fetch。它只决定"算不算新鲜"，不改变拉取频率。
AG_MODEL_UPSTREAM_TTL_MS=3600000
# 管理员令牌：门禁 POST /ag/models/sync（手动触发元数据同步，给将来 WebUI 用）。
# **不设置 = 该路由返回 503 并拒绝一切请求**（"没配令牌"与"令牌不对"必须可区分）。
# 值只在进程内，不进日志、不进 trace、不落库。
AG_ADMIN_TOKEN=

# ---- 数据面鉴权（66-auth.md §2）----
# 单 access token（极简模式）：设一个值即可跑起来，不需要建 key 表。
# 与虚拟 key **互斥**——虚拟 key 模式启用时它被忽略（判定见 auth/data-plane.ts：
# 显式开了虚拟 key、或虚拟 key 库里已有 ≥1 把 key，就是虚拟 key 模式）。
# 值不落盘、不进日志、不进 trace。
AG_ACCESS_TOKEN=
# 显式启用数据面虚拟 key 模式（库还空着时就要按虚拟 key 跑）。
# 不设也行：建了第一把 key 会自动切过去。
AG_VIRTUAL_KEYS=false
# 显式放行数据面：不校验任何凭据（permissive 模式）。
# **默认 false = 默认拒绝**：AG_ACCESS_TOKEN 与 AG_VIRTUAL_KEYS 都没配时，数据面
# 整个关掉（503），而不是谁都能进——系统对外公开的标准下一次部署遗漏不能等于
# 一次数据泄露。只有本地裸跑 / demo / 内网自用才该设 1，且要在部署脚本里写明。
AG_DATA_PLANE_PERMISSIVE=false
