{
  // markdownlint-cli2 配置（review #7）
  //
  // 关掉的两条：
  //   MD013（行宽）      —— 中文长句不断行，默认 80 字符会报 ~1000 处，全是噪音。
  //   MD060（表格风格）  —— 本仓库的表格是手写对齐的，MD060 的管道风格与现有写法冲突（~670 处）。
  //
  // 保留的（issue 明确要求）：
  //   MD032（列表前后空行）、MD040（代码块必须标语言）、MD036（不要用加粗冒充标题）
  //   —— 这三条直接关系到"GitHub 上渲染成什么样"，已把存量违规全部修掉（见 CHANGELOG）。
  //
  // 默认规则实测（markdownlint-cli2 v0.24.1 / markdownlint v0.42.1，2026-11-14）：
  //   全关时：MD013 ~1031、MD060 ~668、MD032 84、MD040 23、MD036 12、
  //           MD028 3、MD034 2、MD033 2、MD012 1、MD029 6
  //   当前配置下：0 issues。
  "globs": [
    "docs/**/*.md",
    "*.md"
  ],
  "config": {
    "MD013": false,
    "MD060": false
  },
  "ignores": ["node_modules/**", ".git/**"]
}
