{
  "$id": "https://agentgateway.local/schema/ag-ir-1/envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "\u5171\u4eab\u4fe1\u5c01\uff08CanonicalRequestEnvelope / CanonicalResponseEnvelope\uff09",
  "description": "docs/design/10-canonical-schema.md \u00a72 \u5171\u4eab\u4fe1\u5c01 + \u00a77 raw passthrough \u4e24\u7ea7\u7ed3\u6784\u3002ir_version \u5fc5\u586b\uff08\u51b3\u7b56 D6\uff09\uff1a\u65b0\u589e\u6a21\u6001\u8d70\u6ce8\u518c\u8868\uff0c\u4e0d\u65b0\u589e\u9876\u5c42\u5b57\u6bb5\u3002",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ir_version": {
      "const": "ag-ir/1"
    },
    "kind": {
      "enum": [
        "chat",
        "decision",
        "embedding",
        "tts",
        "asr",
        "image",
        "rerank",
        "moderation",
        "video"
      ],
      "description": "\u6a21\u6001\u5224\u522b\u3002decision \u662f\u7b2c 9 \u4e2a\u6a21\u6001\uff0c\u52ff\u79f0'\u7b2c\u4e94\u6a21\u6001'\uff0800 \u00a75 \u672f\u8bed\u8868\uff09"
    },
    "model": {
      "type": "string"
    },
    "resolved_model": {
      "type": "string"
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "mode", "on_mismatch"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "enum": ["sse", "chunked-binary", "ws-duplex", "none"]
        },
        "include_usage": {
          "type": "boolean"
        },
        "native_event_names": {
          "type": "boolean"
        },
        "on_mismatch": {
          "enum": ["reject", "bridge", "buffer"]
        }
      }
    },
    "payload": {
      "description": "\u6a21\u6001\u7279\u5b9a payload\uff1b\u6309 kind \u5224\u522b",
      "type": "object"
    },
    "source_format": {
      "type": "string"
    },
    "raw": {
      "$ref": "#/$defs/RawEnvelope"
    },
    "gateway": {
      "type": "object",
      "properties": {
        "agentic_loop": {
          "type": "boolean"
        },
        "max_turns": {
          "type": "integer"
        },
        "builtin_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "debug": {
          "type": "boolean"
        }
      }
    },
    "request_id": {
      "type": "string"
    },
    "usage": {
      "$ref": "usage.schema.json"
    },
    "finish_reason": {
      "enum": [
        "stop",
        "length",
        "tool_use",
        "content_filter",
        "stop_sequence",
        "error",
        "pause_turn",
        "recitation",
        "context_exceeded",
        "missing_thought_signature",
        "other",
        "final"
      ],
      "description": "\u5f52\u4e00\u5316\u5b8c\u6210\u539f\u56e0\uff0c\u662f\u56db\u5bb6\u679a\u4e3e\u7684\u8d85\u96c6\uff0810 \u00a79.3 \u6ce8\u610f 1\uff09"
    },
    "degraded": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ConversionDiagnostic"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calibration"],
      "properties": {
        "calibration": {
          "enum": ["native", "degraded"]
        },
        "degraded_by": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "model", "chat_adaptor"],
          "properties": {
            "reason": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "chat_adaptor": {
              "type": "string"
            }
          }
        }
      },
      "description": "decision \u6a21\u6001\u4e13\u7528\uff0840 \u00a76.3\uff09"
    }
  },
  "$defs": {
    "RawEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unmapped": {
          "type": "object",
          "description": "\u9876\u5c42\u7ea7\uff1a\u8bf7\u6c42/\u54cd\u5e94\u6839\u4e0a\u672a\u5efa\u6a21\u7684\u5b57\u6bb5\u3002additionalProperties:false \u903c\u7740\u5b83\u4eec\u663e\u5f0f\u8fdb\u8fd9\u91cc"
        },
        "nodes": {
          "type": "object",
          "description": "\u8282\u70b9\u7ea7\uff1a\u6bcf\u4e2a canonical \u8282\u70b9\u53ef\u5e26 _raw\uff08\u539f\u6587\u5bf9\u8c61\u6216\u539f\u59cb block\uff09"
        },
        "source_provider": {
          "type": "string",
          "description": "\u56de\u5199\u65f6\u5224\u65ad\u80fd\u5426\u6574\u4f53\u8fd8\u539f"
        },
        "finish_reason_provider": {
          "type": "string",
          "description": "\u4e0a\u6e38\u539f\u59cb finish_reason / stop_reason \u5b57\u7b26\u4e32\uff0810 \u00a79.3 \u6ce8\u610f 3\uff1a\u53cc\u5411\u53ef\u9006\uff09"
        }
      }
    },
    "ConversionDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "from", "to", "level", "message"],
      "properties": {
        "code": {
          "type": "string"
        },
        "field_path": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "level": {
          "enum": ["info", "warning", "error"]
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
