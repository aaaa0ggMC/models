{
  "name": "agentgateway",
  "version": "0.1.0",
  "private": true,
  "description": "AgentGateway —— 自托管多模态 LLM API 网关（canonical 中间格式 AG-IR + 双向格式互转 + 插件 + 计量）。实现依据 docs/design/。",
  "type": "module",
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:admin && node scripts/copy-static-assets.mjs",
    "reload": "sudo systemctl reload agentgateway",
    "build:admin": "tsc --noEmit -p webui/admin/tsconfig.json && vite build --config webui/admin/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:admin": "tsc --noEmit -p webui/admin/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "schema:check": "node scripts/check-json-schema.mjs",
    "check:ui-copy": "node scripts/check-ui-copy.mjs",
    "demo": "npm run build && node scripts/e2e-demo.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@douyinfe/semi-icons": "^2.105.0",
    "@douyinfe/semi-ui": "^2.105.0",
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.0",
    "openai": "^4.104.0",
    "prettier": "^3.6.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.6",
    "vitest": "^3.2.4"
  }
}
