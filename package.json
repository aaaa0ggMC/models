{
  "name": "agentgateway",
  "version": "0.1.0",
  "private": true,
  "description": "AgentGateway —— 自托管多模态 LLM API 网关（canonical 中间格式 AG-IR + 双向格式互转 + 插件 + 计量）。实现依据 docs/design/。",
  "type": "module",
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "schema:check": "node scripts/check-json-schema.mjs",
    "demo": "node --experimental-strip-types scripts/demo-e2e.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
